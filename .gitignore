# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Artefatos locais de execução (os artefatos do relatório publicado são versionados
# de propósito — ver `artifacts/` e `reports/` no README).
artifacts/*.local.json
*.local.ndjson

# Pesos de modelo baixados
.cache/
models/

# Artefatos de runtime do harness Hermes que não devem ser versionados.
# O CLI grava cache em HERMES_HOME sempre que roda — por isso a sonda o executa
# com um HERMES_HOME temporário, e por isso estes padrões existem aqui.
.update_check
*.db-wal
*.db-shm

# Editores / sistema
.vscode/
.idea/
.DS_Store

# Arquivo de CI mantido fora do versionamento: o token do GitHub App desta
# sessão não tem a permissão `workflows`. Adicione pelo site do GitHub.
.github/workflows/
